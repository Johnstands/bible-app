{
  "name": "bible-app",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "data:fetch": "bash scripts/fetch-sources.sh",
    "data:build": "node scripts/build-bible-db.mjs",
    "test": "vitest run",
    "ui:dev": "vite --port 1430 --strictPort",
    "glossary:gaps": "node scripts/glossary-gaps.mjs",
    "glossary:review": "node scripts/glossary-review.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
