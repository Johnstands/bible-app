<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by Tauri. macOS shows this when asking whether the app may
     control Keynote, which it does to turn a presentation into slides (see src/convert.rs);
     without it, macOS refuses silently. -->
<plist version="1.0">
<dict>
  <key>NSAppleEventsUsageDescription</key>
  <string>KJV Reader's Bible uses Keynote to turn a presentation you add to a playlist into slides.</string>
</dict>
</plist>
