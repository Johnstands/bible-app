{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KJV Reader's Bible",
  "mainBinaryName": "bible-app",
  "version": "0.1.9",
  "identifier": "com.jxyeverfight.bibleapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KJV Reader's Bible",
        "width": 960,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "backgroundColor": "#faf6ec"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/bible.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "An offline King James Bible reader",
    "longDescription": "A quiet, offline reader for the King James Version. Search, highlight, bookmark and add notes, and get help with archaic words and words whose meaning has changed since 1611.",
    "copyright": "The King James Version text is in the public domain.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOEE4QkNGRkE5MjZDMkYKUldRdmJKTDZ6NHVLcXF6VnN0NkhneTIzeGI1ME9TbHJtdTk1WVVXOUxMZnJwNWtvS2M2bnRXNjUK",
      "endpoints": [
        "https://github.com/Johnstands/bible-app/releases/latest/download/latest.json"
      ]
    }
  }
}
